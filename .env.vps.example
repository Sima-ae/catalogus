# Use this .env ON THE VPS at /var/www/superclones.cloud/
# Build and run with: npm run build && npm run start

NODE_ENV=production

# CyberPanel docRoot (for scripts/sync-public-html.sh after each deploy)
CATALOGUS_PUBLIC_HTML=/home/superclones.cloud/public_html

# Public URL (app at site root — no /catalogus path)
NEXT_PUBLIC_APP_URL=https://superclones.cloud
# Leave empty or omit for root deploy; only set if you use a subpath again
NEXT_PUBLIC_BASE_PATH=

DATABASE_DRIVER=mariadb
# MUST be 127.0.0.1 on the VPS (MariaDB on same server). Copy password from CyberPanel → Databases.
# User + database name are usually supe_r_clones_cloud (with supe_ prefix).
DATABASE_URL=mysql://supe_r_clones_cloud:YOUR_PASSWORD@127.0.0.1:3306/supe_r_clones_cloud
# If password has @ # or % characters, use separate vars instead of DATABASE_URL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=supe_r_clones_cloud
# DB_PASSWORD=your_password
# DB_NAME=supe_r_clones_cloud

AUTH_DEV_FALLBACK=false

# Cap Next.js MariaDB pool (lower if import:worker runs on the same VPS)
DB_CONNECTION_LIMIT=8

# Optional Redis for shared TTL cache across requests (shop-nav, catalog pages,
# homepage shuffle, count buckets). Strongly recommended on the VPS — without it
# each Node process only has an in-memory cache that resets on restart.
# Debian/Ubuntu:  apt install redis-server && systemctl enable --now redis-server
# Alma/RHEL/CentOS (CyberPanel):  dnf install -y redis && systemctl enable --now redis
REDIS_URL=redis://127.0.0.1:6379/0

# Keep a single Next.js process (systemd catalogus.service). Do NOT enable PM2
# cluster mode — multiple workers multiply CPU and fragment the in-memory cache.
# Prefer Redis + caching before adding more Node processes.
# Import worker: only allow runs in this UTC hour window (e.g. 1-6 = 01:00–05:59 UTC).
# Pass --force on the CLI to override. Empty = always allowed.
# IMPORT_WORKER_ALLOWED_HOURS=1-6

# Optional marketing hosts → default category (same app/DB, scoped landing).
# CATEGORY_HOST_MAP=watches.superclones.cloud:WATCHES,perfumes.superclones.cloud:PERFUMES

# Featured-only storefront hosts (www.1-1.club) — shop catalog shows products.featured=1 only.
# Same Next.js process + MariaDB as Super Clones. See deploy/vhost-1-1.club.snippet.
# These hosts skip the site-access password gate (public); Super Clones still uses it.
FEATURED_ONLY_HOSTS=www.1-1.club,1-1.club

# Per-host public brand overrides (site_name|optional tagline). Settings table remains default.
HOST_SITE_BRAND=www.1-1.club:1-1 Club|Featured picks,1-1.club:1-1 Club|Featured picks

# Sign site-access unlock cookies (16+ random characters)
# Required for site-wide access password (min 16 characters). After changing: sudo systemctl restart catalogus
SITE_ACCESS_COOKIE_SECRET=replace-with-at-least-16-random-characters

# Optional long-lived key for trusted server scrapers (min 16 chars). Prefer minting a
# short-lived token via POST /api/internal/scrape-token with super-admin email+password,
# then send header X-Catalogus-Scrape-Token. Without either, all bots/scrapers get HTTP 404.
# SCRAPE_BYPASS_SECRET=replace-with-at-least-16-random-characters

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
