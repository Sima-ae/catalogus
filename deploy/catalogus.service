# systemd unit — install on VPS:
#   sudo cp deploy/catalogus.service /etc/systemd/system/catalogus.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable catalogus
#   sudo systemctl start catalogus
#
# Runs as root so deploy scripts, npm, and public_html paths share one owner (no EACCES).

[Unit]
Description=Catalogus Next.js (superclones.cloud)
After=network.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/superclones.cloud
Environment=NODE_ENV=production
# Load .env like a shell (handles passwords better than EnvironmentFile alone)
EnvironmentFile=-/var/www/superclones.cloud/.env
# Port 3001 — port 3000 is used by inkoop-autos (PM2) on this VPS
ExecStart=/bin/bash -c 'set -a && [ -f .env ] && . ./.env && set +a && exec npm run start -- -p 3001'
Restart=on-failure
RestartSec=5
# Soft CPU cap so a stampede cannot starve MariaDB / inkoop on the same VPS.
CPUQuota=80%
Nice=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=catalogus

# Single process only (npm run start). Do not switch to PM2 cluster — that
# doubles CPU and splits the in-process TTL cache. Use REDIS_URL instead.
[Install]
WantedBy=multi-user.target
