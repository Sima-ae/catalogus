# Oneshoot: scan Yupoo/supplier albums and mark gone products sold out.
#
# App lives in the git/Node tree (often /var/www/superclones.cloud), NOT in
# CyberPanel public_html. Confirm with:
#   systemctl show catalogus -p WorkingDirectory --value
#
# Install (create units if deploy/ is not on the server yet):
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now catalogus-mark-unavailable.timer

[Unit]
Description=Catalogus mark unavailable Yupoo/source products sold out
After=network.target mariadb.service mysql.service catalogus.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/superclones.cloud
Environment=NODE_ENV=production
# Do not bash-source .env — HOST_SITE_BRAND values with spaces break `set -a . ./.env`.
EnvironmentFile=-/var/www/superclones.cloud/.env
# Modest batch so CPU stays calm; timer runs often enough to catch deletions.
ExecStart=/usr/bin/npx tsx scripts/mark-unavailable-source-products.ts --apply --limit=200 --concurrency=1 --delay-ms=800
Nice=10
CPUQuota=25%
# Prevent a hung scan from holding MariaDB connections for days.
TimeoutStartSec=45min
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=catalogus-mark-unavailable