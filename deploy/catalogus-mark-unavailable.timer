# Daily at 00:00 Europe/Amsterdam (CET/CEST) — mark gone Yupoo/source products sold out.
#
#   sudo systemctl enable --now catalogus-mark-unavailable.timer
#   systemctl list-timers | grep mark-unavailable

[Unit]
Description=Run Catalogus unavailable-source scan daily at midnight CET

[Timer]
OnCalendar=*-*-* 00:00:00 Europe/Amsterdam
Persistent=true

[Install]
WantedBy=timers.target
